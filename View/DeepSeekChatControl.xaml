<UserControl x:Class="DeepSeek_v4_for_VisualStudio.View.DeepSeekChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utils="clr-namespace:DeepSeek_v4_for_VisualStudio.Utils"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <UserControl.Resources>
        <!-- ═══ 深色主题样式 ═══ -->
        <!-- ComboBox 深色样式（VS 2022 风格） -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          SnapsToDevicePixels="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="6,3,0,3"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Fill="#888888"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stroke="#888888"
                                                      StrokeThickness="1"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#4A4A4A"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#666666"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,25,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   SnapsToDevicePixels="True">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#3C3C3C"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            CornerRadius="3"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem 深色样式 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#264F78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox 深色样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 强调按钮样式（发送等主操作）：与 TransparentButton 同一几何语言（圆角 3、居中内容），
             仅保留强调底色以区分主次，悬停/按下态为强调色的加深/减淡 -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2D5A8C"/>
            <Setter Property="BorderBrush" Value="#2D5A8C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AccentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentBorder" Property="Background" Value="#3A6BA6"/>
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="#3A6BA6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AccentBorder" Property="Background" Value="#24496F"/>
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="#24496F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter TargetName="AccentBorder" Property="Background" Value="#3C3C3C"/>
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 透明按钮样式 -->
        <Style x:Key="TransparentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3C3C3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 会话选择栏 ═══ -->
        <Border Grid.Row="0"
                Background="#2D2D2D"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid>
                <!-- P-B：Copilot 式历史交互 —— 时钟按钮打开历史浮层，标题常显 -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="HistoryToggleButton"
                            Content="&#xE81C;"
                            Click="HistoryToggleButton_Click"
                            Style="{StaticResource TransparentButton}"
                            ToolTip="历史对话"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13" Padding="4,0"
                            Foreground="#888888"
                            Cursor="Hand"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="CurrentSessionTitle"
                               Text=""
                               FontSize="12"
                               Foreground="#D4D4D4"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NewChatButton" Content="+ 新对话" Click="NewChatButton_Click"
                            Style="{StaticResource TransparentButton}"
                            Margin="0,0,6,0" FontSize="12"
                            Foreground="#4EC9B0" />
                    <Button x:Name="DeleteSessionButton"
                            Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                            ToolTip="删除当前对话"
                            Click="DeleteSessionButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#888888"
                            FontSize="11"
                            Cursor="Hand"
                            Padding="4,0"
                            Width="20"
                            Height="20"
                            Panel.ZIndex="1">
                        <Button.Resources>
                            <Style TargetType="Border"/>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- 兼容保留：旧逻辑引用点（不可见）-->
                <ComboBox x:Name="SessionComboBox"
                          MinWidth="180"
                          Height="26"
                          Visibility="Collapsed"
                          SelectionChanged="SessionComboBox_SelectionChanged"
                          DisplayMemberPath="Title" />
            </Grid>
        </Border>

        <!-- ═══ P-B 历史会话浮层（Copilot 式）═══ -->
        <Popup x:Name="HistoryPopup"
               PlacementTarget="{Binding ElementName=HistoryToggleButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">
            <Border x:Name="HistoryPopupBorder"
                    Background="#2D2D2D"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    MinWidth="300"
                    MaxHeight="380">
                <ListBox x:Name="HistoryListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="HistoryListBox_SelectionChanged"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#D4D4D4"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastActiveText}"
                                               Foreground="#888888"
                                               FontSize="10" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="&#xE74D;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="11"
                                        Foreground="#888888"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="4,2"
                                        ToolTip="删除此对话"
                                        Loaded="HistoryDeleteButton_Loaded"
                                        Visibility="{Binding DeleteVisibility}"
                                        Tag="{Binding Id}"
                                        Click="DeleteHistoryItem_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="HB"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HB" Property="Background" Value="#3C3C3C" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="HB" Property="Background" Value="#264F78" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>

        <!-- ═══ WebView2 聊天显示区 (Chromium) ═══ -->
        <!-- WebView2 is created programmatically in InitializeChatWebView() to avoid
             XamlParseException caused by assembly version conflicts with ReSharper.
             See GitHub issue #18. -->
        <!-- ClipToBounds=True 修复 GitHub issue #31: WebView2 HWND 穿透覆盖其他 VS 面板 -->
        <ContentControl Grid.Row="1"
                        x:Name="ChatWebViewHost"
                        Margin="0"
                        ClipToBounds="True" />

        <!-- ═══ Diff 预览全局控制栏 ═══ -->
        <Border Grid.Row="2"
                x:Name="DiffGlobalBar"
                Background="#1A3A20"
                BorderBrush="#3F3F46" BorderThickness="0,1,0,0"
                Padding="10,4"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="DiffGlobalLabel"
                           Foreground="#E0E0E0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="检测到文件变更" />
                <TextBlock Grid.Column="1"
                           x:Name="DiffGlobalDetail"
                           Foreground="#90B090"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="UndoAllButton"
                            Content="撤销全部"
                            Click="UndoAllDiffButton_Click"
                            Background="#5C2A2A"
                            Foreground="#E0E0E0"
                            BorderThickness="0"
                            MinWidth="72" MinHeight="22"
                            FontSize="11"
                            Cursor="Hand"
                            Padding="8,2"
                            Margin="0,0,4,0" />
                    <Button x:Name="AcceptAllButton"
                            Content="接受全部"
                            Click="AcceptAllDiffButton_Click"
                            Background="#1A6A2A"
                            Foreground="#E0E0E0"
                            BorderThickness="0"
                            MinWidth="72" MinHeight="22"
                            FontSize="11"
                            Cursor="Hand"
                            Padding="8,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 状态行 ═══ -->
        <Border Grid.Row="3"
                x:Name="StatusAreaBorder"
                Background="#2D2D2D"
                BorderBrush="#3F3F46" BorderThickness="0,1,0,1"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel"
                           Grid.Column="0"
                           FontSize="11"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <Border x:Name="AgentModeBadge"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="60" Height="18"
                        CornerRadius="3"
                        Background="#555555"
                        BorderThickness="1"
                        BorderBrush="#666666"
                        Visibility="Collapsed">
                    <TextBlock x:Name="AgentModeText"
                               Text="ASK"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="8,0" />
                </Border>
            </Grid>
        </Border>

        <!-- ═══ 输入区 ═══ -->
        <Border Grid.Row="4"
                x:Name="InputAreaBorder"
                Background="#2D2D2D"
                BorderBrush="#3F3F46" BorderThickness="0,1,0,0"
                Padding="0">
            <Grid Margin="12,6,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <Popup x:Name="AddContextPopup"
                       PlacementTarget="{Binding ElementName=AddContextButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade"
                       HorizontalOffset="0"
                       VerticalOffset="4">
                    <Border Background="#2D2D2D"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2"
                            MinWidth="200">
                        <StackPanel>
                            <MenuItem x:Name="AddActiveDocMenuItem" Header="添加活动文档"
                                      Click="AddActiveDocument_Click"
                                      ToolTip="将当前编辑器中的活动文档内容添加到对话上下文"
                                      Background="#2D2D2D" Foreground="#D4D4D4"
                                      Padding="10,6" FontSize="13" />
                            <MenuItem x:Name="AddProjectFileMenuItem" Header="添加项目文件…"
                                      Click="AddProjectFiles_Click"
                                      ToolTip="从项目中选择文件添加到对话上下文"
                                      Background="#2D2D2D" Foreground="#D4D4D4"
                                      Padding="10,6" FontSize="13" />
                            <MenuItem x:Name="AddAllFilesMenuItem" Header="添加项目全部文件"
                                      Click="AddAllProjectFiles_Click"
                                      ToolTip="一键将当前解决方案中所有项目的源代码文件添加到对话上下文"
                                      Background="#2D2D2D" Foreground="#D4D4D4"
                                      Padding="10,6" FontSize="13" />
                            <Separator Background="#555555" Margin="4,2" />
                            <MenuItem x:Name="AddSelectionMenuItem" Header="添加选中代码块"
                                      Click="AddSelectedCode_Click"
                                      ToolTip="将编辑器中当前选中的代码块添加到对话上下文"
                                      Background="#2D2D2D" Foreground="#D4D4D4"
                                      Padding="10,6" FontSize="13" />
                            <MenuItem x:Name="AddDebugMenuItem" Header="添加调试输出"
                                      Click="AddDebugOutput_Click"
                                      ToolTip="将 Visual Studio 输出窗口中的调试信息添加到对话上下文"
                                      Background="#2D2D2D" Foreground="#D4D4D4"
                                      Padding="10,6" FontSize="13" />
                        </StackPanel>
                    </Border>
                </Popup>

                <TextBox Grid.Row="0"
                         x:Name="InputTextBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="56"
                         MaxHeight="150"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#D4D4D4"
                         CaretBrush="#D4D4D4"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="10,8,8,4"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown"
                         TextChanged="InputTextBox_TextChanged"
                         GotFocus="InputTextBox_GotFocus"
                         LostFocus="InputTextBox_LostFocus" />

                <!-- 输入框占位提示文字（无内容且无焦点时显示） -->
                <TextBlock Grid.Row="0"
                           x:Name="InputPlaceholder"
                           Text="输入问题..."
                           Foreground="#555555"
                           FontSize="12"
                           Padding="12,8,8,4"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False"
                           Panel.ZIndex="0" />

                <!-- ═══ Skill 斜杠命令自动补全弹出框 ═══ -->
                <Popup x:Name="SkillSuggestionPopup"
                       PlacementTarget="{Binding ElementName=InputTextBox}"
                       Placement="Top"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade"
                       HorizontalOffset="4"
                       VerticalOffset="-4">
                    <Border Background="#2D2D2D"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2"
                            MinWidth="260"
                            MaxWidth="400"
                            MaxHeight="240">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       x:Name="SkillPopupTitle"
                                       FontSize="11"
                                       Foreground="#888888"
                                       Margin="8,6,8,4" />
                            <ListBox Grid.Row="1"
                                     x:Name="SkillSuggestionListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#D4D4D4"
                                     FontSize="12"
                                     MaxHeight="200"
                                     PreviewKeyDown="SkillSuggestionListBox_PreviewKeyDown"
                                     SelectionChanged="SkillSuggestionListBox_SelectionChanged"
                                     MouseDoubleClick="SkillSuggestionListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name, StringFormat='/{0}'}"
                                                       Foreground="#6CAFD9"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Description}"
                                                       Foreground="#C8C8C8"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Source}"
                                                       Foreground="#888888"
                                                       FontSize="10"
                                                       Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="3">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#3C3C3C" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#264F78" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>

                <!-- ═══ @Agent 路由自动补全弹出框 ═══ -->
                <Popup x:Name="AgentSuggestionPopup"
                       PlacementTarget="{Binding ElementName=InputTextBox}"
                       Placement="Top"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade"
                       HorizontalOffset="4"
                       VerticalOffset="-4">
                    <Border Background="#2D2D2D"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2"
                            MinWidth="280"
                            MaxWidth="420"
                            MaxHeight="240">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       x:Name="AgentPopupTitle"
                                       FontSize="11"
                                       Foreground="#888888"
                                       Margin="8,6,8,4" />
                            <ListBox Grid.Row="1"
                                     x:Name="AgentSuggestionListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#D4D4D4"
                                     FontSize="12"
                                     MaxHeight="200"
                                     PreviewKeyDown="AgentSuggestionListBox_PreviewKeyDown"
                                     SelectionChanged="AgentSuggestionListBox_SelectionChanged"
                                     MouseDoubleClick="AgentSuggestionListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontSize="14"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayPrefix}"
                                                       Foreground="#CEA85C"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Description}"
                                                       Foreground="#C8C8C8"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="3">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#3C3C3C" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#264F78" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>

                <!-- 已上传文件标签区 -->
                <ItemsControl Grid.Row="1"
                              x:Name="AttachedFilesControl"
                              Margin="4,4,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#264F78"
                                    CornerRadius="3"
                                    Padding="6,2" Margin="0,0,4,2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TransparentButton}"
                                            Padding="0"
                                            Margin="0,0,5,0"
                                            Click="OpenAttachedFile_Click"
                                            Tag="{Binding FilePath}"
                                            ToolTip="{Binding FileName}">
                                        <Grid Width="38" Height="38">
                                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons"
                                                       FontSize="20"
                                                       Foreground="#C8C8C8"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding ThumbnailSource}"
                                                   Stretch="Uniform"
                                                   Width="38"
                                                   Height="38" />
                                        </Grid>
                                    </Button>
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="#D4D4D4"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                                            Foreground="#888888"
                                            FontSize="10"
                                            Style="{StaticResource TransparentButton}"
                                            Padding="2,0"
                                            Margin="4,0,0,0"
                                            Click="RemoveAttachedFile_Click"
                                            Tag="{Binding FileName}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧: 模型、思考和搜索设置 -->
                    <!-- P2：独立主题切换已移除，主题始终跟随 IDE -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AddContextButton" Content="&#xE710;"
                                Click="AddContextButton_Click"
                                Style="{StaticResource TransparentButton}"
                                FontFamily="Segoe Fluent Icons"
                                ToolTip="添加上下文（活动文档 / 项目文件 / 全部文件 / 选中代码 / 调试输出）"
                                FontSize="12" Padding="6,0" Margin="0,0,4,0"
                                Foreground="#6CAFD9" />

                        <Button x:Name="UploadButton" Content="&#xE723;"
                            Click="UploadButton_Click"
                            Style="{StaticResource TransparentButton}"
                            ToolTip="上传文件 (支持 .txt .doc .xls .py .c 等)"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13" Padding="6,0" Margin="0,0,2,0"
                            Foreground="#CE9178" />
                        <ComboBox x:Name="ModelComboBox"
                                  MinWidth="130" Margin="4,0,4,0"
                                  ToolTip="{utils:I18n input.modelTip}"
                                  SelectionChanged="ModelComboBox_SelectionChanged" />
                        <CheckBox x:Name="ThinkingCheckBox"
                                  VerticalAlignment="Center" Margin="2,0,4,0"
                                  Checked="ThinkingCheckBox_Changed"
                                  Unchecked="ThinkingCheckBox_Changed" />
                        <!-- TODO: RagCheckBox 暂时注释掉，功能未完善
                        <CheckBox x:Name="RagCheckBox"
                                  VerticalAlignment="Center" Margin="2,0,4,0"
                                  Checked="RagCheckBox_Changed"
                                  Unchecked="RagCheckBox_Changed" />
                        -->
                        <ComboBox x:Name="EffortComboBox"
                                  MinWidth="65" Margin="2,0,4,0"
                                  SelectionChanged="EffortComboBox_SelectionChanged" />
                        <ComboBox x:Name="WebSearchEngineComboBox"
                            MinWidth="100" Margin="2,0,4,0"
                            SelectionChanged="WebSearchEngineComboBox_SelectionChanged"
                            ToolTip="选择搜索引擎"
                            Visibility="Collapsed" />
                        <Button x:Name="WebSearchToggleButton"
                                Click="WebSearchToggleButton_Click"
                                Style="{StaticResource TransparentButton}"
                                ToolTip="联网搜索: 已关闭"
                                FontSize="14" Padding="4,0" Margin="0,0,8,0"
                                Foreground="#888888">
                            <Button.Content>
                                <TextBlock Text="&#xE774;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                            </Button.Content>
                        </Button>
                        <Button x:Name="McpConfigButton"
                                Click="McpConfigButton_Click"
                                Style="{StaticResource TransparentButton}"
                                ToolTip="配置 MCP 服务器"
                                FontSize="14" Padding="4,0" Margin="0,0,2,0"
                                Foreground="#888888">
                            <Button.Content>
                                <TextBlock Text="&#xE713;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                            </Button.Content>
                        </Button>
                        <!-- 清空按钮：置于左侧设置组末尾，与发送保持远距离防误触 -->
                        <Rectangle Width="1" Height="14" Fill="#454545"
                                   VerticalAlignment="Center" Margin="4,0,4,0" />
                        <Button x:Name="ClearButton" Content="清空" Click="ClearButton_Click"
                                Style="{StaticResource TransparentButton}"
                                Margin="2,0,0,0" Padding="8,2"
                                FontSize="12" Foreground="#888888"
                                BorderBrush="#555555" BorderThickness="1"
                                ToolTip="清空当前对话（需确认）" />
                    </StackPanel>

                    <!-- 右侧: 仅发送控制（清空已移至左侧组，防误触）-->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StopButton" Content="&#xE71A;" FontFamily="Segoe Fluent Icons"
                                Click="StopButton_Click"
                                Style="{StaticResource AccentButton}"
                                FontSize="13"
                                Visibility="Collapsed"
                                ToolTip="停止生成 (Esc)" />
                        <Button x:Name="SendButton" Content="&#xE724;" FontFamily="Segoe Fluent Icons"
                                Click="SendButton_Click"
                                Style="{StaticResource AccentButton}"
                                FontSize="13"
                                ToolTip="发送 (Enter)" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 审批控制栏 ═══ -->
        <Border Grid.Row="5"
                x:Name="ApprovalAreaBorder"
                Background="#2D2D2D"
                BorderBrush="#3F3F46" BorderThickness="0,1,0,0"
                Padding="12,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：审批模式 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ApprovalModeLabel"
                               Text="{utils:I18n chat.approvalModeLabel}"
                               Foreground="#D4D4D4"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox x:Name="ApprovalModeComboBox"
                              MinWidth="130"
                              Height="22"
                              SelectionChanged="ApprovalModeComboBox_SelectionChanged" />
                </StackPanel>

                <!-- 右侧：余额和 Token 显示 -->
                <Border Grid.Column="2"
                        x:Name="BalanceBar"
                        Background="Transparent"
                        Padding="4,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="BalanceLabel"
                               FontSize="11"
                               Foreground="#888888"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
